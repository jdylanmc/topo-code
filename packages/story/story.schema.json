{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topo.dev/schemas/story-1.0.json",
  "title": "Topo authored story",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "summary", "anchors", "sections", "connections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "diagramFamily": {
      "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"]
    },
    "classification": {
      "enum": ["source-grounded", "capability-demo"]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 }
        },
        "dependentRequired": {
          "pattern": ["symbol"]
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "anchorIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "anchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
      {
        "if": {
          "not": {
            "properties": {
              "classification": { "const": "capability-demo" }
            },
            "required": ["classification"]
          }
        },
        "then": {
          "properties": {
            "anchors": { "type": "array", "minItems": 1 },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "anchorIds": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "diagramFamily": { "enum": ["sequence", "dataflow"] }
          },
          "required": ["diagramFamily"]
        },
        "then": {
          "properties": {
            "connections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string", "minLength": 1 }
                },
                "required": ["label"]
              }
            }
          }
        }
      }
  ]
}
