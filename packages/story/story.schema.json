{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topo.dev/schemas/story-1.0.json",
  "$defs": {
    "storyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyId"],
      "properties": {
        "storyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "title": "Topo authored story",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "summary", "anchors", "sections", "connections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "renderer": { "enum": ["archify", "graphviz"] },
    "diagramFamily": {
      "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"]
    },
    "classification": {
      "enum": ["source-grounded", "capability-demo"]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "parent": {
      "allOf": [
        { "$ref": "#/$defs/storyTarget" },
        { "type": "object", "properties": { "nodeId": {} }, "required": ["nodeId"] }
      ]
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "language": { "enum": ["typescript", "javascript", "rust", "text"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "anchorIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "drilldown": { "$ref": "#/$defs/storyTarget" },
          "summary": { "type": "string", "minLength": 1 },
          "semanticRole": { "type": "string", "pattern": "^(?!constructor$)[a-z][a-z0-9-]{0,63}$" },
          "kind": { "enum": ["step", "decision", "data"] },
          "anchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "variant": { "const": "return" },
          "classification": { "enum": ["source-traced", "inferred"] },
          "rationale": { "type": "string", "minLength": 1 },
          "anchorIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "classification": {} }, "required": ["classification"] },
            "then": { "properties": { "anchorIds": {}, "rationale": {} }, "required": ["anchorIds", "rationale"] },
            "else": { "not": { "anyOf": [{ "properties": { "anchorIds": {} }, "required": ["anchorIds"] }, { "properties": { "rationale": {} }, "required": ["rationale"] }] } }
          },
          {
            "if": { "properties": { "classification": { "const": "source-traced" } }, "required": ["classification"] },
            "then": { "properties": { "anchorIds": { "type": "array", "minItems": 1 } } }
          }
        ]
      }
    }
  },
  "allOf": [
      {
        "if": { "properties": { "sections": { "type": "array", "contains": { "type": "object", "properties": { "summary": {} }, "required": ["summary"] } } } },
        "then": { "properties": { "diagramFamily": { "const": "architecture" } } }
      },
      {
        "if": { "properties": { "sections": { "type": "array", "contains": { "type": "object", "properties": { "semanticRole": {} }, "required": ["semanticRole"] } } } },
        "then": { "properties": { "diagramFamily": { "enum": ["architecture", "sequence"] } } }
      },
      {
        "if": { "properties": { "renderer": { "const": "graphviz" } }, "required": ["renderer"] },
        "then": {
          "required": ["diagramFamily"],
          "properties": {
            "diagramFamily": { "const": "workflow" },
            "anchors": { "type": "array", "items": { "type": "object", "properties": { "sha256": {} }, "required": ["sha256"] } },
            "connections": { "type": "array", "items": { "type": "object", "properties": { "classification": {} }, "required": ["classification"] } }
          }
        },
        "else": { "properties": { "sections": { "type": "array", "items": { "type": "object", "not": { "properties": { "kind": {} }, "required": ["kind"] } } } } }
      },
      {
        "if": {
          "not": {
            "properties": {
              "classification": { "const": "capability-demo" }
            },
            "required": ["classification"]
          }
        },
        "then": {
          "properties": {
            "anchors": { "type": "array", "minItems": 1 },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "anchorIds": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "diagramFamily": { "enum": ["sequence", "dataflow"] }
          },
          "required": ["diagramFamily"]
        },
        "then": {
          "properties": {
            "connections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string", "minLength": 1 }
                },
                "required": ["label"]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "connections": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "variant": { "const": "return" }
                },
                "required": ["variant"]
              }
            }
          },
          "required": ["connections"]
        },
        "then": {
          "properties": {
            "diagramFamily": { "const": "sequence" }
          },
          "required": ["diagramFamily"]
        }
      }
  ]
}
