{
  "name": "@topo/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./index.html": "./dist/index.html"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.mjs",
    "benchmark": "node ../../benchmarks/renderer-bakeoff.mjs"
  },
  "dependencies": {
    "@topo/enrichment": "workspace:*",
    "@topo/graph": "workspace:*",
    "@topo/modules": "workspace:*",
    "@topo/schema": "workspace:*",
    "@topo/views": "workspace:*",
    "pixi.js": "^8.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
