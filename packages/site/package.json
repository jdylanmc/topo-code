{
  "name": "@topo/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./notices": "./dist/THIRD_PARTY_NOTICES.txt",
    "./data": {
      "types": "./src/data.ts",
      "default": "./dist/data-contract/data.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.data.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && yarn typecheck:browser",
    "typecheck:browser": "tsc -p tsconfig.browser-tests.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.mjs",
    "benchmark": "node ../../benchmarks/renderer-bakeoff.mjs"
  },
  "dependencies": {
    "@topo/enrichment": "workspace:*",
    "@topo/graph": "workspace:*",
    "@topo/modules": "workspace:*",
    "@topo/schema": "workspace:*",
    "@topo/views": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "pixi.js": "^8.13.2",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
