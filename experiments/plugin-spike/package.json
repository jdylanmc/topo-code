{
  "name": "topocode-plugin-spike",
  "version": "0.1.0-spike.1",
  "private": true,
  "type": "module",
  "description": "Experimental, local-only TypeScript/Rust/Tauri baseline and agent-adoption spike.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "topo-spike": "./bin/topo-spike.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "pack:local": "npm pack --ignore-scripts --pack-destination artifacts",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "REPORT.md",
    "evidence",
    "LICENSE"
  ],
  "dependencies": {
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.45.3",
    "@iarna/toml": "2.2.5",
    "@jdylanmc/topo-archify": "0.1.0",
    "@jdylanmc/topo-code": "0.1.0",
    "@viz-js/viz": "3.30.0"
  },
  "license": "MIT"
}
